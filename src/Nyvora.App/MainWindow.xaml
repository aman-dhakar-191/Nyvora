<Window
    x:Class="Nyvora.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Nyvora.App.UI">

    <Grid x:Name="Root" Background="#FF0B0B10" RequestedTheme="Dark">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="OnCompactAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewTaskAccelerator" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Quit Nyvora" Click="OnQuit" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Expanded content: fixed width so it never reflows while the window grows. -->
        <ui:TasksPanel x:Name="Panel" HorizontalAlignment="Left"
                       VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />

        <!-- Settings: opens to the right of the pill by widening the window, not by replacing the tasks. -->
        <ui:SettingsView x:Name="Side" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0"
                         IsHitTestVisible="False" CloseRequested="OnSettingsClose" />
        <Border x:Name="SideDivider" Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Background="#22FFFFFF" Opacity="0" IsHitTestVisible="False" />

        <!-- Resize grip: drag to resize the expanded pill (kept under the top edge); double-click resets. -->
        <ui:ResizeGrip x:Name="Grip" Width="16" Height="16" Margin="0,0,10,10" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Background="Transparent" Opacity="0" IsHitTestVisible="False"
                       ToolTipService.ToolTip="Drag to resize. Double-click to reset."
                       PointerPressed="OnGripPressed" PointerMoved="OnGripMoved" PointerReleased="OnGripReleased"
                       PointerCaptureLost="OnGripCaptureLost" DoubleTapped="OnGripDoubleTapped">
            <Path Data="M 14,3 L 3,14 M 14,8 L 8,14" Stroke="#80FFFFFF" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </ui:ResizeGrip>

        <!-- Resting content: covers the whole pill, shows the hand cursor, and expands on tap. -->
        <ui:HandGrid x:Name="RestingContent" Background="Transparent" Tapped="OnRestingTapped">
            <StackPanel x:Name="RestingStack" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF5EEAD4" VerticalAlignment="Center" />
                <!-- Due and open by default; a temporary status or message ("/notch" or an agent) takes its place while it lasts. -->
                <TextBlock x:Name="RestingLabel" Text="Nyvora" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFE7E7EE" MaxWidth="300" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </ui:HandGrid>

    </Grid>
</Window>

<Window
    x:Class="Nyvora.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Nyvora.App.UI">

    <Grid x:Name="Root" Background="#FF0B0B10">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Quit Nyvora" Click="OnQuit" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Expanded content: fixed width so it never reflows while the window grows. -->
        <ui:TasksPanel x:Name="Panel" Width="420" Height="400" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />

        <!-- Resting content: covers the whole pill, shows the hand cursor, and expands on tap. -->
        <ui:HandGrid x:Name="RestingContent" Background="Transparent" Tapped="OnRestingTapped">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF5EEAD4" VerticalAlignment="Center" />
                <TextBlock x:Name="RestingLabel" Text="Nyvora" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFE7E7EE" />
            </StackPanel>
        </ui:HandGrid>

        <!-- Subtle 1px edge; rounded clipping comes from the window region. -->
        <Border BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>

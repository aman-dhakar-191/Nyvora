<UserControl
    x:Class="Nyvora.App.UI.StatusSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Nyvora.App.UI">

    <StackPanel Spacing="8">
        <TextBlock FontSize="12" Foreground="#FF9A9AB0" TextWrapping="Wrap"
                   Text="Rename, reorder, add or remove. Tick Done for statuses that finish a task. Keep at least one done and one not done." />

        <StackPanel x:Name="Rows" Spacing="4" />

        <!-- Same columns as the rows above: name, Done, then the Add button over the three icon columns. -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewName" PlaceholderText="New status name" MaxLength="24" KeyDown="OnNewKeyDown" />
            <ui:HandCheckBox x:Name="NewDone" Grid.Column="1" Content="Done" MinWidth="0" Margin="6,0,0,0" />
            <ui:HandButton Grid.Column="2" Grid.ColumnSpan="3" Content="Add" Click="OnAdd" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>

        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFFB7185" MinHeight="16" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>

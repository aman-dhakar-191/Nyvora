<UserControl
    x:Class="Nyvora.App.UI.TagSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Nyvora.App.UI">

    <StackPanel Spacing="8">
        <TextBlock FontSize="12" Foreground="#FF9A9AB0" TextWrapping="Wrap"
                   Text="Tags label your tasks. Create them here or from the # button on a task. Click a color to change it." />

        <StackPanel x:Name="Rows" Spacing="4" />

        <!-- Same columns as the rows above, so the name boxes and the Add / delete buttons line up. -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewName" Grid.Column="1" PlaceholderText="New tag name" MaxLength="20" KeyDown="OnNewKeyDown" />
            <ui:HandButton Grid.Column="2" Content="Add" Click="OnAdd" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>

        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFFB7185" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>

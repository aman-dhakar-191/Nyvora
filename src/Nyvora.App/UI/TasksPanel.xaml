<UserControl
    x:Class="Nyvora.App.UI.TasksPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Nyvora.App.UI"
    RequestedTheme="Dark">

    <Grid x:Name="TasksView" Padding="22,18,22,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title with a quiet count underneath, icon-only actions on the right. -->
        <Grid>
            <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="10" Height="10" Fill="#FF5EEAD4" VerticalAlignment="Center" />
                    <TextBlock Text="Tasks" FontSize="20" FontWeight="SemiBold" Foreground="#FFF4F4F8" />
                </StackPanel>
                <TextBlock x:Name="Summary" FontSize="12" Foreground="#FF8A8AA0" Margin="20,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:HandButton Click="OnSettingsClick" Padding="7" BorderThickness="0" Background="Transparent"
                               ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </ui:HandButton>
                <ui:HandButton Click="OnCollapse" Padding="7" BorderThickness="0" Background="Transparent"
                               ToolTipService.ToolTip="Collapse (Esc)">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </ui:HandButton>
                <ui:HandButton Click="OnQuit" Padding="7" BorderThickness="0" Background="Transparent"
                               ToolTipService.ToolTip="Quit Nyvora">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                </ui:HandButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" PlaceholderText="Add a task, press Enter" MaxLength="200" MinHeight="38"
                     VerticalContentAlignment="Center" Padding="12,0" KeyDown="OnInputKeyDown" />
            <ui:HandButton x:Name="ReminderButton" Grid.Column="1" Click="OnReminderButtonClick" MinHeight="38" MinWidth="44"
                           ToolTipService.ToolTip="Add a reminder to the next task">
                <TextBlock x:Name="ReminderLabel" Text="⏰" FontSize="13" />
            </ui:HandButton>
        </Grid>

        <!-- Opens under the input only when the reminder button is clicked. -->
        <Border x:Name="ReminderPicker" Grid.Row="2" Visibility="Collapsed" CornerRadius="8"
                Background="#14FFFFFF" Padding="10,8">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:HandButton Content="10 min" Tag="InTenMinutes" Click="OnPickPreset" Padding="10,3" FontSize="12" />
                    <ui:HandButton Content="1 hour" Tag="InOneHour" Click="OnPickPreset" Padding="10,3" FontSize="12" />
                    <ui:HandButton Content="Tomorrow 9:00" Tag="TomorrowMorning" Click="OnPickPreset" Padding="10,3" FontSize="12" />
                    <ui:HandButton x:Name="PickerClear" Content="Clear" Click="OnPickClear" Padding="10,3" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TimePicker x:Name="PickerTime" />
                    <ui:HandButton Content="Set" Click="OnPickerSet" Padding="14,5" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Spacing="2" />
        </ScrollViewer>

        <!-- Only appears when an update is waiting; installing lives in Settings. -->
        <ui:HandButton x:Name="UpdateNotice" Grid.Row="4" Visibility="Collapsed" Click="OnSettingsClick"
                       Padding="8,3" FontSize="12" Foreground="#FF60A5FA" BorderThickness="0" Background="Transparent"
                       HorizontalAlignment="Left" ToolTipService.ToolTip="Open settings to install" />
    </Grid>
</UserControl>

<UserControl
    x:Class="Nyvora.App.UI.TasksPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Nyvora.App.UI"
    RequestedTheme="Dark">

    <Grid>
    <Grid x:Name="TasksView" Padding="24,18,24,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Width="10" Height="10" Fill="#FF5EEAD4" VerticalAlignment="Center" />
                <TextBlock Text="Tasks" FontSize="20" FontWeight="SemiBold" Foreground="#FFF4F4F8" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="Summary" FontSize="12" Foreground="#FF9A9AB0" VerticalAlignment="Center" />
                <ui:HandButton Click="OnSettingsClick" Padding="6" BorderThickness="0" Background="Transparent"
                               ToolTipService.ToolTip="Task statuses">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </ui:HandButton>
            </StackPanel>
        </Grid>

        <TextBox x:Name="Input" Grid.Row="1" PlaceholderText="Add a task, press Enter" MaxLength="200"
                 KeyDown="OnInputKeyDown" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Add with reminder:" FontSize="12" Foreground="#FF9A9AB0" VerticalAlignment="Center" />
            <ui:HandButton Content="10 min" Tag="InTenMinutes" Click="OnAddWithReminder" Padding="10,4" />
            <ui:HandButton Content="1 hour" Tag="InOneHour" Click="OnAddWithReminder" Padding="10,4" />
            <ui:HandButton Content="Tomorrow 9:00" Tag="TomorrowMorning" Click="OnAddWithReminder" Padding="10,4" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Spacing="2" />
        </ScrollViewer>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UpdateText" FontSize="12" Foreground="#FF9A9AB0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <ui:HandButton x:Name="UpdateButton" Grid.Column="1" Padding="10,3" FontSize="12"
                           Click="OnUpdateClick" />
        </Grid>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:HandCheckBox x:Name="TopToggle" Content="Always on top" FontSize="12" MinWidth="0"
                             Click="OnTopClick" VerticalAlignment="Center" />
            <ui:HandButton Grid.Column="1" Content="Collapse" Click="OnCollapse" />
            <ui:HandButton Grid.Column="2" Content="Quit" Click="OnQuit" />
        </Grid>
    </Grid>
    <ui:StatusSettingsView x:Name="Settings" Visibility="Collapsed" BackRequested="OnSettingsBack" />
    </Grid>
</UserControl>
